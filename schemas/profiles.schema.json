{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "hexscope-profiles.schema.json",
  "title": "Hex Scope profile registry",
  "description": "The single-file profile registry: one ProfileRecord[] array of named annotation bundles (typeInstances, active integrity checks, endian, segment names, labels). Not file-owned. Envelope root tolerates extra keys; nested payload objects are strict; item ids are unique.",
  "type": "object",
  "required": [
    "version",
    "data"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "data": {
      "type": "object",
      "required": [
        "schemaVersion",
        "records"
      ],
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "minimum": 1,
          "description": "Data-schema version of the payload. The current build migrates older values forward on load; a newer value is left untouched (forward-only)."
        },
        "records": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/profileRecord"
          }
        }
      },
      "additionalProperties": false
    },
    "$schema": {
      "type": "string"
    }
  },
  "additionalProperties": true,
  "definitions": {
    "profileRecord": {
      "type": "object",
      "required": [
        "id",
        "name",
        "typeInstances",
        "activeChecks",
        "endian",
        "bitAllocation",
        "segmentNames",
        "labels"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "typeInstances": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/typeInstance"
          }
        },
        "structPins": {
          "deprecated": true,
          "description": "Deprecated v1 alias for typeInstances. Accepted for strict authoring of files still carrying the pre-rename key; the runtime normalizer reads typeInstances ?? structPins ?? pins. New files must use typeInstances.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/typeInstance"
          }
        },
        "pins": {
          "deprecated": true,
          "description": "Deprecated pre-rename alias for typeInstances. Accepted for strict authoring of files still carrying the old key; the runtime normalizer reads typeInstances ?? structPins ?? pins. New files must use typeInstances.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/typeInstance"
          }
        },
        "activeChecks": {
          "$ref": "#/definitions/integrityCheckSet"
        },
        "endian": {
          "enum": [
            "le",
            "be"
          ]
        },
        "bitAllocation": {
          "enum": [
            "lsb",
            "msb"
          ]
        },
        "showHiddenFields": {
          "type": "boolean",
          "description": "Global toggle for the Instances view: when true, fields marked hidden in the types editor are rendered. Absent = false."
        },
        "segmentNames": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "labels": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/segmentLabel"
          }
        }
      },
      "additionalProperties": false
    },
    "segmentLabel": {
      "type": "object",
      "required": [
        "id",
        "name",
        "startAddress",
        "length",
        "color"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "startAddress": {
          "type": "number"
        },
        "length": {
          "type": "number"
        },
        "color": {
          "type": "string"
        },
        "hidden": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "typeInstance": {
      "type": "object",
      "required": [
        "id",
        "typeId",
        "addr",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "typeId": {
          "type": "string"
        },
        "addr": {
          "type": "number"
        },
        "name": {
          "type": "string"
        },
        "paramValues": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "paramSources": {
          "type": "object",
          "description": "Optional @script size sources keyed by parameter name. The resolved value is transient and never persisted; paramValues (manual) wins when both exist.",
          "additionalProperties": {
            "type": "object",
            "required": [
              "scriptPath"
            ],
            "properties": {
              "scriptPath": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "addressSource": {
          "type": "object",
          "description": "Optional @script address source. The resolved address is transient and never persisted; addr stays the fixed fallback.",
          "required": [
            "scriptPath"
          ],
          "properties": {
            "scriptPath": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "pointerSources": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/typePointerSource"
          }
        }
      },
      "additionalProperties": false
    },
    "typePointerSource": {
      "type": "object",
      "required": [
        "sourcePinId",
        "sourcePinName",
        "sourceTypeId",
        "sourceFieldPath",
        "pointerStorageAddress",
        "targetAddress"
      ],
      "properties": {
        "sourcePinId": {
          "type": "string"
        },
        "sourcePinName": {
          "type": "string"
        },
        "sourceTypeId": {
          "type": "string"
        },
        "sourceFieldPath": {
          "type": "string"
        },
        "pointerStorageAddress": {
          "type": "number"
        },
        "targetAddress": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "integrityCheckSet": {
      "type": "object",
      "required": [
        "schemaVersion",
        "checks"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/integrityCheckConfig"
          }
        }
      },
      "additionalProperties": false
    },
    "integrityCheckConfig": {
      "type": "object",
      "required": [
        "startAddress",
        "endAddress",
        "autoFixStoredValue"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "builtin",
            "script"
          ]
        },
        "algorithm": {
          "$ref": "#/definitions/integrityAlgorithm"
        },
        "scriptPath": {
          "type": "string",
          "minLength": 1
        },
        "startAddress": {
          "type": "number"
        },
        "endAddress": {
          "type": "number"
        },
        "storedAddress": {
          "type": "number"
        },
        "autoFixStoredValue": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "maxLength": 40
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "script"
              }
            }
          },
          "then": {
            "required": [
              "scriptPath"
            ],
            "not": {
              "required": [
                "algorithm"
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "builtin"
              }
            }
          },
          "then": {
            "required": [
              "algorithm"
            ],
            "not": {
              "required": [
                "scriptPath"
              ]
            }
          }
        },
        {
          "if": {
            "not": {
              "required": [
                "kind"
              ]
            }
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "algorithm"
                ]
              },
              {
                "required": [
                  "scriptPath"
                ]
              }
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "integrityAlgorithm": {
      "type": "string",
      "enum": [
        "crc16-ccitt-false",
        "crc32-iso-hdlc",
        "md5",
        "sha-1",
        "sha-256",
        "sha-512"
      ]
    }
  }
}