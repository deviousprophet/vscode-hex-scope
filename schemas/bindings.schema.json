{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "hexscope-bindings.schema.json",
  "title": "Hex Scope binding table",
  "description": "Per-file bindings in the three-tier profile system: fileKey (workspace-relative posix path) → profileId, plus the optional per-file raw-binary base-address table. Envelope root tolerates extra keys; entries are strict.",
  "type": "object",
  "required": [
    "version",
    "data"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "data": {
      "type": "object",
      "required": [
        "schemaVersion",
        "bindings"
      ],
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "minimum": 1,
          "description": "Data-schema version of the payload. The current build migrates older values forward on load; a newer value is left untouched (forward-only)."
        },
        "bindings": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/binding"
          }
        },
        "binBases": {
          "type": "array",
          "description": "Per-file raw-binary memory-map base addresses. Independent of profiles: switching or deleting a profile never changes a base.",
          "items": {
            "$ref": "#/definitions/binBase"
          }
        }
      },
      "additionalProperties": false
    },
    "$schema": {
      "type": "string"
    }
  },
  "additionalProperties": true,
  "definitions": {
    "binding": {
      "type": "object",
      "required": [
        "fileKey",
        "profileId"
      ],
      "properties": {
        "fileKey": {
          "type": "string"
        },
        "profileId": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "binBase": {
      "type": "object",
      "required": [
        "fileKey",
        "baseAddress"
      ],
      "properties": {
        "fileKey": {
          "type": "string"
        },
        "baseAddress": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "additionalProperties": false
    }
  }
}