{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "hexscope-types.schema.json",
  "title": "Hex Scope type pool",
  "description": "Workspace-wide TypeDef[] in the three-tier profile system. Envelope root tolerates extra keys (forward compat); nested payload objects are strict.",
  "type": "object",
  "required": [
    "version",
    "data"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "data": {
      "type": "object",
      "required": [
        "schemaVersion",
        "defs"
      ],
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "minimum": 1,
          "description": "Data-schema version of the payload. The current build migrates older values forward on load; a newer value is left untouched (forward-only)."
        },
        "defs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/typeDef"
          }
        }
      },
      "additionalProperties": false
    },
    "$schema": {
      "type": "string"
    }
  },
  "additionalProperties": true,
  "definitions": {
    "typeDef": {
      "type": "object",
      "required": [
        "id",
        "name",
        "fields"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/typeField"
          }
        },
        "kind": {
          "enum": [
            "struct",
            "bitfield",
            "enum"
          ]
        },
        "baseType": {
          "enum": [
            "uint8",
            "uint16",
            "uint32",
            "uint64"
          ]
        },
        "bitFields": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/bitFieldChild"
          }
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/enumEntry"
          }
        },
        "packed": {
          "type": "boolean"
        },
        "endian": {
          "enum": [
            "le",
            "be"
          ]
        },
        "allocation": {
          "enum": [
            "lsb",
            "msb"
          ]
        }
      },
      "additionalProperties": false
    },
    "typeField": {
      "type": "object",
      "required": [
        "name",
        "type",
        "count"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "$ref": "#/definitions/typeFieldType"
        },
        "isPointer": {
          "type": "boolean"
        },
        "refTypeId": {
          "type": "string"
        },
        "bitFields": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/bitFieldChild"
          }
        },
        "count": {
          "type": "number"
        },
        "bitFieldsCollapsed": {
          "type": "boolean"
        },
        "hidden": {
          "type": "boolean"
        },
        "endian": {
          "enum": [
            "le",
            "be"
          ]
        },
        "allocation": {
          "enum": [
            "lsb",
            "msb"
          ]
        }
      },
      "additionalProperties": false
    },
    "bitFieldChild": {
      "type": "object",
      "required": [
        "name",
        "bitWidth"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "bitWidth": {
          "type": "number"
        },
        "refTypeId": {
          "type": "string"
        },
        "hidden": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "enumEntry": {
      "type": "object",
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "typeFieldType": {
      "type": "string",
      "enum": [
        "void",
        "ascii",
        "uint8",
        "uint16",
        "uint32",
        "uint64",
        "int8",
        "int16",
        "int32",
        "int64",
        "float32",
        "float64",
        "pointer",
        "struct",
        "bitfield",
        "enum"
      ]
    }
  }
}
