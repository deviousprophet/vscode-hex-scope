{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022"],
        "module": "preserve",
        "moduleResolution": "bundler",
        "strict": true,
        "noEmit": true,
        "allowJs": true,
        "checkJs": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "types": []
    },
    "include": ["scripts/**/*.js"]
}
